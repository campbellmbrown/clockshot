{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/ClockShot.App/ClockShot.App.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format",
      "type": "process",
      "command": "dotnet",
      "args": ["format", "${workspaceFolder}/ClockShot.slnx"],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--solution", "${workspaceFolder}/ClockShot.slnx"],
      "group": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
