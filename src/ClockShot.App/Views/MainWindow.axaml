<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClockShot.App.ViewModels"
        xmlns:controls="using:ClockShot.App.Controls"
        xmlns:input="using:ClockShot.App.Input"
        xmlns:core="using:ClockShot.Core"
        x:Class="ClockShot.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static core:AppInfo.Name}"
        Width="1400"
        Height="850"
        MinWidth="900"
        MinHeight="600"
        Icon="{Binding Tracking.IsPaused, Converter={x:Static controls:AppIcon.FromIsPaused}}">
  <DockPanel>
    <!-- Keys come from Input/Shortcuts.cs. MenuShortcuts makes the window-wide ones work while the menu is closed. -->
    <Menu x:Name="MainMenu"
          DockPanel.Dock="Top"
          AutomationProperties.AutomationId="MainMenu">
      <MenuItem Header="_File" AutomationProperties.AutomationId="FileMenu">
        <MenuItem Header="E_xit"
                  Command="{Binding ExitCommand}"
                  AutomationProperties.AutomationId="ExitMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.Exit}" />
      </MenuItem>
      <MenuItem Header="_View" AutomationProperties.AutomationId="ViewMenu">
        <MenuItem Header="_Timeline"
                  InputGesture="{x:Static input:Shortcuts.ShowTimeline}"
                  Command="{Binding ShowPageCommand}"
                  CommandParameter="{Binding Timeline}"
                  AutomationProperties.AutomationId="TimelineMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.Timeline}" />
        <MenuItem Header="_Settings"
                  InputGesture="{x:Static input:Shortcuts.ShowSettings}"
                  Command="{Binding ShowPageCommand}"
                  CommandParameter="{Binding Settings}"
                  AutomationProperties.AutomationId="SettingsMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.Settings}" />
        <Separator />
        <MenuItem Header="P_revious day"
                  InputGesture="{x:Static input:Shortcuts.PreviousDay}"
                  Command="{Binding OnTimeline}"
                  CommandParameter="{Binding Timeline.PreviousDayCommand}"
                  AutomationProperties.AutomationId="PreviousDayMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.PreviousDay}" />
        <MenuItem Header="_Next day"
                  InputGesture="{x:Static input:Shortcuts.NextDay}"
                  Command="{Binding OnTimeline}"
                  CommandParameter="{Binding Timeline.NextDayCommand}"
                  AutomationProperties.AutomationId="NextDayMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.NextDay}" />
        <MenuItem Header="T_oday"
                  InputGesture="{x:Static input:Shortcuts.Today}"
                  Command="{Binding OnTimeline}"
                  CommandParameter="{Binding Timeline.GoToTodayCommand}"
                  AutomationProperties.AutomationId="TodayMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.Today}" />
        <Separator />
        <MenuItem Header="Zoom _in"
                  InputGesture="{x:Static input:Shortcuts.ZoomIn}"
                  Command="{Binding OnTimeline}"
                  CommandParameter="{Binding Timeline.ZoomInCommand}"
                  AutomationProperties.AutomationId="ZoomInMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.ZoomIn}" />
        <MenuItem Header="Zoom _out"
                  InputGesture="{x:Static input:Shortcuts.ZoomOut}"
                  Command="{Binding OnTimeline}"
                  CommandParameter="{Binding Timeline.ZoomOutCommand}"
                  AutomationProperties.AutomationId="ZoomOutMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.ZoomOut}" />
        <MenuItem Header="Show the _whole day"
                  InputGesture="{x:Static input:Shortcuts.ShowWholeDay}"
                  Command="{Binding OnTimeline}"
                  CommandParameter="{Binding Timeline.FitDayCommand}"
                  AutomationProperties.AutomationId="ShowWholeDayMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.ShowWholeDay}" />
      </MenuItem>
      <MenuItem Header="_Tracking" AutomationProperties.AutomationId="TrackingMenu">
        <MenuItem Header="{Binding Tracking.PauseCommandText}"
                  Command="{Binding Tracking.TogglePausedCommand}"
                  AutomationProperties.AutomationId="TogglePausedMenuItem"
                  controls:MenuIcon.Kind="{Binding Tracking.PauseCommandIconKind}" />
      </MenuItem>
      <MenuItem Header="_Help" AutomationProperties.AutomationId="HelpMenu">
        <MenuItem Header="{Binding Source={x:Static core:AppInfo.Name}, StringFormat='_About {0}'}"
                  Command="{Binding ShowAboutCommand}"
                  AutomationProperties.AutomationId="AboutMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.About}" />
        <MenuItem Header="_Keyboard shortcuts"
                  Command="{Binding ShowShortcutsCommand}"
                  AutomationProperties.AutomationId="ShortcutsMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.KeyboardShortcuts}" />
        <MenuItem Header="Open _log folder"
                  Command="{Binding OpenLogFolderCommand}"
                  AutomationProperties.AutomationId="OpenLogFolderMenuItem"
                  controls:MenuIcon.Kind="{x:Static controls:Icons.OpenFolder}" />
      </MenuItem>
    </Menu>

    <!-- Shows the tracking state and the window being recorded. -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="0,1,0,0"
            Padding="6,2"
            AutomationProperties.AutomationId="StatusBar">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Button Command="{Binding StatusBar.Tracking.TogglePausedCommand}"
                ToolTip.Tip="{Binding StatusBar.Tracking.PauseCommandText}"
                Background="Transparent"
                BorderThickness="0"
                Padding="6,2"
                AutomationProperties.AutomationId="StatusBarState">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="8"
                     Height="8"
                     Fill="{Binding StatusBar.State, Converter={x:Static controls:StatusBarBrushes.FromState}}"
                     VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusBar.StateText}"
                       Classes="small"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Grid.Column="1"
                   Classes="secondary small"
                   Text="{Binding StatusBar.WindowText}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"
                   AutomationProperties.AutomationId="StatusBarWindow" />
      </Grid>
    </Border>

    <TabControl ItemsSource="{Binding Pages}"
                SelectedItem="{Binding SelectedPage}"
                AutomationProperties.AutomationId="MainTabs">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="vm:PageViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:Icon Kind="{Binding IconKind}"
                           Width="20"
                           Height="20"
                           VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
  </DockPanel>
</Window>
