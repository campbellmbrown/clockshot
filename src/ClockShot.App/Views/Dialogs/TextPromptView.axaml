<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:ClockShot.App.ViewModels.Dialogs"
             x:Class="ClockShot.App.Views.Dialogs.TextPromptView"
             x:DataType="dialogs:TextPromptViewModel">
  <StackPanel Spacing="6" Width="380">
    <TextBlock Text="{Binding Label}" />
    <TextBox x:Name="TextBox"
             Text="{Binding Text}"
             AutomationProperties.AutomationId="PromptText" />
  </StackPanel>
</UserControl>
