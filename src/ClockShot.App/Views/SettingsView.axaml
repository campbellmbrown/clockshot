<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClockShot.App.ViewModels"
             xmlns:core="using:ClockShot.Core"
             xmlns:settings="using:ClockShot.Core.Settings"
             xmlns:timeline="using:ClockShot.App.ViewModels.Timeline"
             xmlns:controls="using:ClockShot.App.Controls"
             x:Class="ClockShot.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <!-- Each setting row is a Grid with its label in a fixed-width column, so the controls line up. -->
    <Style Selector="Grid.setting">
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Grid.setting > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Width" Value="150" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="FormatString" Value="0" />
      <!-- Every number setting is whole, so a typed decimal is refused instead of being cut short. -->
      <Setter Property="ParsingNumberStyle" Value="Integer" />
    </Style>
    <Style Selector="StackPanel.section">
      <Setter Property="Spacing" Value="2" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24,16"
                MaxWidth="760"
                HorizontalAlignment="Left">
      <TextBlock Classes="secondary"
                 Text="Changes are saved straight away."
                 Margin="0,0,0,16" />

      <!-- General -->
      <StackPanel Classes="section">
        <TextBlock Classes="h2"
                   Text="General"
                   Margin="0,0,0,6" />
        <CheckBox Content="Close to tray"
                  ToolTip.Tip="{Binding Source={x:Static core:AppInfo.Name}, StringFormat='Closing the window keeps {0} running in the tray.'}"
                  IsChecked="{Binding CloseToTray}" />
        <Grid Classes="setting"
              ColumnDefinitions="280,*"
              ToolTip.Tip="The hour a new day starts. If you work past midnight, set it to an hour after you stop.">
          <TextBlock Text="Day start (hour)" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding DayStartHour}"
                         Minimum="{Binding Min, Source={x:Static settings:SettingLimits.DayStartHour}}"
                         Maximum="{Binding Max, Source={x:Static settings:SettingLimits.DayStartHour}}"
                         AutomationProperties.AutomationId="SettingDayStartHour" />
        </Grid>
      </StackPanel>

      <!-- Tracking -->
      <StackPanel Classes="section">
        <TextBlock Classes="h2"
                   Text="Tracking"
                   Margin="0,0,0,6" />
        <Grid Classes="setting"
              ColumnDefinitions="280,*"
              ToolTip.Tip="Minutes without keyboard or mouse input before you count as away.">
          <TextBlock Text="Away after (minutes)" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding AwayAfterMinutes}"
                         Minimum="{Binding Min, Source={x:Static settings:SettingLimits.AwayAfterMinutes}}"
                         Maximum="{Binding Max, Source={x:Static settings:SettingLimits.AwayAfterMinutes}}"
                         AutomationProperties.AutomationId="SettingAwayAfter" />
        </Grid>
      </StackPanel>

      <!-- Screenshots -->
      <StackPanel Classes="section">
        <TextBlock Classes="h2"
                   Text="Screenshots"
                   Margin="0,0,0,6" />
        <CheckBox Content="Screenshots"
                  ToolTip.Tip="Take screenshots of the window you're using."
                  IsChecked="{Binding ScreenshotsEnabled}"
                  AutomationProperties.AutomationId="SettingScreenshotsEnabled" />
        <StackPanel IsEnabled="{Binding ScreenshotsEnabled}" Spacing="2">
          <Grid Classes="setting"
                ColumnDefinitions="280,*"
                ToolTip.Tip="Seconds between screenshots.">
            <TextBlock Text="Interval (seconds)" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding ScreenshotIntervalSeconds}"
                           Minimum="{Binding Min, Source={x:Static settings:SettingLimits.ScreenshotIntervalSeconds}}"
                           Maximum="{Binding Max, Source={x:Static settings:SettingLimits.ScreenshotIntervalSeconds}}"
                           Increment="10" />
          </Grid>
          <CheckBox Content="On app switch"
                    ToolTip.Tip="Also take a screenshot shortly after you switch to another app."
                    IsChecked="{Binding CaptureOnAppSwitch}" />
          <Grid Classes="setting"
                ColumnDefinitions="280,*"
                ToolTip.Tip="Wider screenshots are scaled down to this width.">
            <TextBlock Text="Max width (pixels)" />
            <!-- Steps of 160 land on common screen widths, such as 1280, 1920, 2560 and 3840. -->
            <NumericUpDown Grid.Column="1"
                           Value="{Binding ScreenshotMaxWidthPixels}"
                           Minimum="{Binding Min, Source={x:Static settings:SettingLimits.ScreenshotMaxWidthPixels}}"
                           Maximum="{Binding Max, Source={x:Static settings:SettingLimits.ScreenshotMaxWidthPixels}}"
                           Increment="160" />
          </Grid>
          <Grid Classes="setting"
                ColumnDefinitions="280,*"
                ToolTip.Tip="Lower values make smaller files. At 100 the picture is saved without loss.">
            <TextBlock Text="Quality" />
            <NumericUpDown Grid.Column="1"
                           Value="{Binding ScreenshotQuality}"
                           Minimum="{Binding Min, Source={x:Static settings:SettingLimits.ScreenshotQuality}}"
                           Maximum="{Binding Max, Source={x:Static settings:SettingLimits.ScreenshotQuality}}"
                           Increment="5" />
          </Grid>
          <Grid Classes="setting"
                ColumnDefinitions="280,*"
                ToolTip.Tip="Never take screenshots of these apps.">
            <TextBlock Text="Excluded apps" />
            <StackPanel Grid.Column="1" Spacing="6">
              <ItemsControl ItemsSource="{Binding ExcludedApps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,0,0,4">
                      <TextBlock Text="{Binding}"
                                 VerticalAlignment="Center"
                                 MinWidth="200" />
                      <Button ToolTip.Tip="Remove"
                              AutomationProperties.Name="{Binding StringFormat='Remove {0}'}"
                              Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveExcludedAppCommand}"
                              CommandParameter="{Binding}">
                        <controls:Icon Kind="{x:Static controls:Icons.Remove}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <AutoCompleteBox Width="220"
                                 ItemsSource="{Binding KnownApps}"
                                 Text="{Binding NewExcludedApp}"
                                 FilterMode="Contains"
                                 MinimumPrefixLength="0"
                                 PlaceholderText="PasswordManager.exe"
                                 AutomationProperties.AutomationId="SettingNewExcludedApp" />
                <Button Command="{Binding AddExcludedAppCommand}" AutomationProperties.AutomationId="SettingAddExcludedApp">
                  <controls:IconText Kind="{x:Static controls:Icons.Add}" Text="Add" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
        <!-- Old screenshots are still deleted while taking them is off, so this row stays usable. -->
        <Grid Classes="setting"
              ColumnDefinitions="280,*"
              ToolTip.Tip="Screenshots older than this many days are deleted within the hour. They can't be recovered.">
          <TextBlock Text="Keep (days)" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding KeepScreenshotsForDays}"
                         Minimum="{Binding Min, Source={x:Static settings:SettingLimits.KeepScreenshotsForDays}}"
                         Maximum="{Binding Max, Source={x:Static settings:SettingLimits.KeepScreenshotsForDays}}"
                         AutomationProperties.AutomationId="SettingKeepDays" />
        </Grid>
        <Grid Classes="setting"
              ColumnDefinitions="280,*"
              ToolTip.Tip="Where the screenshot appears when you hover over the timeline.">
          <TextBlock Text="Preview" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding PreviewModes}"
                    SelectedItem="{Binding PreviewMode}"
                    Width="220">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="timeline:PreviewModeChoice">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Grid Classes="setting"
              ColumnDefinitions="280,*"
              ToolTip.Tip="This is how much disk space the screenshots take up.">
          <TextBlock Text="Space used" />
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="12">
            <TextBlock Text="{Binding StorageText}"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="SettingStorage" />
            <Button Command="{Binding OpenScreenshotFolderCommand}">
              <controls:IconText Kind="{x:Static controls:Icons.OpenFolder}" Text="Open folder" />
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
