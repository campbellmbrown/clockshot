<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClockShot.App.ViewModels"
        xmlns:controls="using:ClockShot.App.Controls"
        x:Class="ClockShot.App.Views.DialogWindow"
        x:DataType="vm:DialogViewModel"
        Title="{Binding Title}"
        Icon="{x:Static controls:AppIcon.Normal}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- The view for the body comes from the data templates in App.axaml. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </Window.KeyBindings>
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top"
               Classes="h2"
               Text="{Binding Title}"
               Margin="0,0,0,14" />
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button Content="Close"
              Command="{Binding CloseCommand}"
              IsDefault="True"
              MinWidth="90"
              AutomationProperties.AutomationId="DialogClose" />
    </StackPanel>
    <ContentControl Content="{Binding}" />
  </DockPanel>
</Window>
