<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projects="using:ClockShot.App.ViewModels.Projects"
             xmlns:controls="using:ClockShot.App.Controls"
             xmlns:timeline="using:ClockShot.Core.Timeline"
             x:Class="ClockShot.App.Views.Projects.ProjectsView"
             x:DataType="projects:ProjectsViewModel">
  <DockPanel Margin="12,8,12,12">
    <!-- Toolbar -->
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBox Width="280"
               Text="{Binding SearchText}"
               PlaceholderText="Search clients, projects and tasks"
               Margin="0,0,12,6"
               AutomationProperties.AutomationId="ProjectSearch">
        <TextBox.InnerLeftContent>
          <controls:Icon Kind="{x:Static controls:Icons.Search}"
                         Margin="8,0,0,0"
                         Opacity="0.7" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  Margin="0,0,12,6">
        <TextBlock Classes="secondary"
                   Text="Time for"
                   VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Periods}"
                  SelectedItem="{Binding SelectedPeriod}"
                  Width="130"
                  AutomationProperties.AutomationId="ProjectPeriod">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="timeline:DatePeriod">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <CheckBox Content="Show archived"
                IsChecked="{Binding ShowArchived}"
                Margin="0,0,12,6"
                AutomationProperties.AutomationId="ShowArchived" />
      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  Margin="0,0,0,6">
        <Button Command="{Binding NewClientCommand}" AutomationProperties.AutomationId="NewClientButton">
          <controls:IconText Kind="{x:Static controls:Icons.NewClient}" Text="New client" />
        </Button>
        <Button Command="{Binding NewProjectCommand}"
                CommandParameter="{Binding SelectedNode}"
                ToolTip.Tip="Adds a project to the selected client, or a sub-project to the selected project"
                AutomationProperties.AutomationId="NewProjectButton">
          <controls:IconText Kind="{x:Static controls:Icons.NewProject}" Text="New project" />
        </Button>
        <Button Command="{Binding NewTaskCommand}"
                CommandParameter="{Binding SelectedNode}"
                ToolTip.Tip="Adds a task to the selected project"
                AutomationProperties.AutomationId="NewTaskButton">
          <controls:IconText Kind="{x:Static controls:Icons.NewTask}" Text="New task" />
        </Button>
      </StackPanel>
    </WrapPanel>

    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Message}"
               Foreground="{DynamicResource SystemFillColorCautionBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,8"
               AutomationProperties.AutomationId="ProjectsMessage"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Panel>
      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 MaxWidth="460"
                 HorizontalAlignment="Left"
                 IsVisible="{Binding IsEmpty}"
                 Text="No projects yet. Add one with New project, or from the tag editor when you tag time on the timeline." />

      <TreeView ItemsSource="{Binding Nodes}"
                SelectedItem="{Binding SelectedNode}"
                MaxWidth="760"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="ProjectTree">
        <TreeView.Styles>
          <!-- Archived rows (shown only with "Show archived") are dimmed. -->
          <Style Selector="Grid.archived">
            <Setter Property="Opacity" Value="0.5" />
          </Style>
          <Style Selector="TreeViewItem" x:DataType="projects:CatalogNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="projects:CatalogNodeViewModel" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="8"
                  MinWidth="520"
                  Background="Transparent"
                  Classes.archived="{Binding IsArchived}">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="New project here"
                            Command="{Binding $parent[UserControl].((projects:ProjectsViewModel)DataContext).NewProjectCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding CanHoldProjects}"
                            controls:MenuIcon.Kind="{x:Static controls:Icons.NewProject}" />
                  <MenuItem Header="New task"
                            Command="{Binding $parent[UserControl].((projects:ProjectsViewModel)DataContext).NewTaskCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsProject}"
                            controls:MenuIcon.Kind="{x:Static controls:Icons.NewTask}" />
                  <MenuItem Header="Edit project..."
                            Command="{Binding $parent[UserControl].((projects:ProjectsViewModel)DataContext).EditProjectCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsProject}"
                            controls:MenuIcon.Kind="{x:Static controls:Icons.Edit}" />
                  <MenuItem Header="Rename..."
                            Command="{Binding $parent[UserControl].((projects:ProjectsViewModel)DataContext).RenameCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsRenamable}"
                            controls:MenuIcon.Kind="{x:Static controls:Icons.Edit}" />
                  <MenuItem Header="{Binding ArchiveText}"
                            Command="{Binding $parent[UserControl].((projects:ProjectsViewModel)DataContext).ToggleArchivedCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsEditable}"
                            controls:MenuIcon.Kind="{x:Static controls:Icons.Archive}" />
                  <MenuItem Header="Delete"
                            Command="{Binding $parent[UserControl].((projects:ProjectsViewModel)DataContext).DeleteCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding IsEditable}"
                            controls:MenuIcon.Kind="{x:Static controls:Icons.Delete}" />
                </ContextMenu>
              </Grid.ContextMenu>
              <controls:Icon Kind="{Binding IconKind}" VerticalAlignment="Center" />
              <Border Grid.Column="1"
                      Width="10"
                      Height="10"
                      CornerRadius="2"
                      Background="{Binding ColorHex, Converter={x:Static controls:ThemeBrushes.FromHex}}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasColor}" />
              <TextBlock Grid.Column="2"
                         Text="{Binding Name}"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3"
                         Classes="secondary"
                         Text="{Binding TotalText}"
                         VerticalAlignment="Center" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Panel>
  </DockPanel>
</UserControl>
