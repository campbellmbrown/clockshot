<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:projects="using:ClockShot.App.ViewModels.Projects"
             x:Class="ClockShot.App.Views.Projects.ProjectDialogView"
             x:DataType="projects:ProjectDialogViewModel">
  <StackPanel Spacing="14" Width="420">
    <Grid ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,Auto,Auto"
          ColumnSpacing="12"
          RowSpacing="10">
      <TextBlock Text="Name" VerticalAlignment="Center" />
      <TextBox Grid.Column="1"
               Text="{Binding Name}"
               AutomationProperties.AutomationId="ProjectDialogName" />

      <TextBlock Grid.Row="1"
                 Text="Client"
                 VerticalAlignment="Center" />
      <AutoCompleteBox Grid.Row="1"
                       Grid.Column="1"
                       ItemsSource="{Binding ClientNames}"
                       Text="{Binding ClientText}"
                       FilterMode="Contains"
                       MinimumPrefixLength="0"
                       PlaceholderText="Optional. A new name adds the client."
                       IsEnabled="{Binding SelectedParent.Project, Converter={x:Static ObjectConverters.IsNull}}"
                       AutomationProperties.AutomationId="ProjectDialogClient" />

      <TextBlock Grid.Row="2"
                 Text="Inside"
                 VerticalAlignment="Center"
                 ToolTip.Tip="Make this a sub-project of another project" />
      <ComboBox Grid.Row="2"
                Grid.Column="1"
                ItemsSource="{Binding ParentOptions}"
                SelectedItem="{Binding SelectedParent}"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="ProjectDialogParent">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="projects:ParentOptionViewModel">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <TextBlock Text="{Binding Error}"
               Classes="error"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
