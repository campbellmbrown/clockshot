<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tagging="using:ClockShot.App.ViewModels.Tagging"
             xmlns:controls="using:ClockShot.App.Controls"
             x:Class="ClockShot.App.Views.Tagging.TagEditorView"
             x:DataType="tagging:TagEditorViewModel">
  <!--
    Enter in any box tags the time or saves the changes.
    When the project list is open, Enter picks the highlighted project instead.
  -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" />
  </UserControl.KeyBindings>

  <StackPanel Spacing="8">
    <TextBlock Classes="h3" Text="{Binding Title}" />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
          RowDefinitions="Auto,Auto,Auto,Auto"
          ColumnSpacing="6"
          RowSpacing="6">
      <TextBlock Text="Project" VerticalAlignment="Center" />
      <AutoCompleteBox x:Name="ProjectBox"
                       Grid.Column="1"
                       ItemsSource="{Binding ProjectOptions}"
                       SelectedItem="{Binding SelectedProject}"
                       Text="{Binding ProjectText}"
                       FilterMode="Custom"
                       ItemFilter="{x:Static tagging:ProjectOptionViewModel.Filter}"
                       MinimumPrefixLength="0"
                       PlaceholderText="Type to search projects"
                       AutomationProperties.AutomationId="TagProjectBox">
        <AutoCompleteBox.ItemTemplate>
          <DataTemplate DataType="tagging:ProjectOptionViewModel">
            <StackPanel Margin="0,2">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Classes="secondary small"
                         Text="{Binding Context}"
                         IsVisible="{Binding HasContext}" />
            </StackPanel>
          </DataTemplate>
        </AutoCompleteBox.ItemTemplate>
      </AutoCompleteBox>
      <Button Grid.Column="2"
              Command="{Binding EditProjectCommand}"
              ToolTip.Tip="Edit this project: name, client and parent"
              AutomationProperties.AutomationId="EditProjectButton">
        <controls:Icon Kind="{x:Static controls:Icons.Edit}" />
      </Button>
      <Button Grid.Column="3"
              Command="{Binding NewProjectCommand}"
              ToolTip.Tip="New project..."
              AutomationProperties.AutomationId="TagNewProjectButton">
        <controls:Icon Kind="{x:Static controls:Icons.NewProject}" />
      </Button>

      <TextBlock Grid.Row="1"
                 Text="Task"
                 VerticalAlignment="Center" />
      <AutoCompleteBox Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       ItemsSource="{Binding TaskOptions}"
                       Text="{Binding TaskText}"
                       FilterMode="Contains"
                       MinimumPrefixLength="0"
                       PlaceholderText="Blank = General"
                       ToolTip.Tip="Leave blank to tag the project in general. A new name creates the task."
                       AutomationProperties.AutomationId="TagTaskBox" />

      <TextBlock Grid.Row="2"
                 Text="Note"
                 VerticalAlignment="Center" />
      <TextBox Grid.Row="2"
               Grid.Column="1"
               Grid.ColumnSpan="3"
               Text="{Binding Note}"
               PlaceholderText="Optional"
               AutomationProperties.AutomationId="TagNoteBox" />

      <!--
        Each project and task pair has one colour.
        Picking a colour unticks Automatic, and ticking it goes back to the colour from the name.
      -->
      <TextBlock Grid.Row="3"
                 Text="Colour"
                 VerticalAlignment="Center" />
      <StackPanel Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="3"
                  Orientation="Horizontal"
                  Spacing="12"
                  ToolTip.Tip="Every tag with this project and task has this colour">
        <ColorPicker Color="{Binding ColorHex, Converter={x:Static controls:HexColorConverter.Instance}}"
                     IsAlphaVisible="False"
                     AutomationProperties.AutomationId="TagColor" />
        <CheckBox Content="Automatic"
                  IsChecked="{Binding UseAutomaticColor}"
                  AutomationProperties.AutomationId="TagAutomaticColor" />
      </StackPanel>
    </Grid>

    <TextBlock Text="{Binding Error}"
               Classes="error"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Classes="accent"
              Command="{Binding ApplyCommand}"
              AutomationProperties.AutomationId="TagApplyButton">
        <controls:IconText Kind="{x:Static controls:Icons.Tag}" Text="{Binding ApplyText}" />
      </Button>
      <Button Command="{Binding DeleteCommand}"
              IsVisible="{Binding IsEditing}"
              AutomationProperties.AutomationId="TagDeleteButton">
        <controls:IconText Kind="{x:Static controls:Icons.Delete}" Text="Delete tag" />
      </Button>
    </StackPanel>

    <StackPanel Spacing="4" IsVisible="{Binding HasRecentTags}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <controls:Icon Kind="{x:Static controls:Icons.RecentTags}"
                       Width="14"
                       Height="14"
                       Opacity="0.7" />
        <TextBlock Classes="secondary" Text="Recently used" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding RecentTags}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="tagging:RecentTagViewModel">
            <Button Margin="0,0,6,6"
                    Padding="8,3"
                    ToolTip.Tip="Use this project and task"
                    Command="{Binding $parent[ItemsControl].((tagging:TagEditorViewModel)DataContext).UseRecentTagCommand}"
                    CommandParameter="{Binding}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="8"
                        Height="8"
                        CornerRadius="2"
                        Background="{Binding ColorHex, Converter={x:Static controls:ThemeBrushes.FromHex}}"
                        VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" Classes="small" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
