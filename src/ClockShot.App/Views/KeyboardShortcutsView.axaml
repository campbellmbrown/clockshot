<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClockShot.App.ViewModels"
             xmlns:input="using:ClockShot.App.Input"
             x:Class="ClockShot.App.Views.KeyboardShortcutsView"
             x:DataType="vm:KeyboardShortcutsViewModel">
  <!-- The list scrolls, so any number of shortcuts fits. -->
  <ScrollViewer MinWidth="520" AutomationProperties.AutomationId="ShortcutsList">
    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,12,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ShortcutGroupViewModel">
          <StackPanel Spacing="4" Margin="0,0,0,12">
            <TextBlock Classes="h3" Text="{Binding Title}" />
            <ItemsControl ItemsSource="{Binding Shortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="input:Shortcut">
                  <Grid ColumnDefinitions="240,*" Margin="0,2">
                    <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Action}"
                               TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
