<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClockShot.App.ViewModels"
             xmlns:controls="using:ClockShot.App.Controls"
             x:Class="ClockShot.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <StackPanel Spacing="20" Width="380">
    <StackPanel Orientation="Horizontal" Spacing="14">
      <controls:Icon Kind="{x:Static controls:Icons.App}"
                     Width="40"
                     Height="40"
                     VerticalAlignment="Center" />
      <TextBlock Classes="secondary"
                 Text="{Binding Description}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <Grid ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,Auto,Auto"
          ColumnSpacing="24"
          RowSpacing="6">
      <TextBlock Grid.Row="0"
                 Classes="secondary"
                 Text="Version" />
      <TextBlock Grid.Row="0"
                 Grid.Column="1"
                 Text="{Binding Version}"
                 AutomationProperties.AutomationId="AboutVersion" />
      <TextBlock Grid.Row="1"
                 Classes="secondary"
                 Text="Runtime" />
      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding Runtime}" />
      <TextBlock Grid.Row="2"
                 Classes="secondary"
                 Text="Avalonia" />
      <TextBlock Grid.Row="2"
                 Grid.Column="1"
                 Text="{Binding AvaloniaVersion}" />
    </Grid>

    <StackPanel Spacing="6">
      <TextBlock Classes="h2" Text="Built with" />
      <ItemsControl ItemsSource="{Binding Credits}" />
    </StackPanel>
  </StackPanel>
</UserControl>
