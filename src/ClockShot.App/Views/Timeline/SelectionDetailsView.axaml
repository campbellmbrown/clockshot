<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:timeline="using:ClockShot.App.ViewModels.Timeline"
             xmlns:views="using:ClockShot.App.Views.Timeline"
             x:Class="ClockShot.App.Views.Timeline.SelectionDetailsView"
             x:DataType="timeline:SelectionDetailsViewModel">
  <ScrollViewer>
    <Panel Margin="16">
      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 IsVisible="{Binding !HasSelection}"
                 Text="Click a block to see details here."
                 AutomationProperties.AutomationId="DetailsEmptyText" />

      <StackPanel Spacing="16" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2"
                     Text="{Binding Heading}"
                     TextWrapping="Wrap"
                     AutomationProperties.AutomationId="DetailsHeading" />
          <TextBlock Classes="secondary"
                     Text="{Binding Subheading}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Subheading, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding TimeRangeText}" AutomationProperties.AutomationId="DetailsTimeRange" />
            <TextBlock Classes="secondary"
                       Text="{Binding TimeText}"
                       AutomationProperties.AutomationId="DetailsDuration" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Classes="h3" Text="Applications" />
          <ItemsControl ItemsSource="{Binding Applications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="timeline:ApplicationTotalViewModel">
                <views:ApplicationTotalRow />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Panel>
  </ScrollViewer>
</UserControl>
