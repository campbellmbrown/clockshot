<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClockShot.App.ViewModels"
             xmlns:timeline="using:ClockShot.App.ViewModels.Timeline"
             xmlns:projects="using:ClockShot.App.ViewModels.Projects"
             xmlns:projectViews="using:ClockShot.App.Views.Projects"
             xmlns:tagging="using:ClockShot.App.ViewModels.Tagging"
             xmlns:taggingViews="using:ClockShot.App.Views.Tagging"
             xmlns:dialogs="using:ClockShot.App.ViewModels.Dialogs"
             xmlns:dialogViews="using:ClockShot.App.Views.Dialogs"
             xmlns:views="using:ClockShot.App.Views"
             xmlns:timelineViews="using:ClockShot.App.Views.Timeline"
             x:Class="ClockShot.App.App"
             RequestedThemeVariant="Dark">
  <!-- Explicit view-model to view mapping: no reflection-based view locator. -->
  <Application.DataTemplates>
    <DataTemplate DataType="timeline:TimelineViewModel">
      <timelineViews:TimelineView />
    </DataTemplate>
    <DataTemplate DataType="projects:ProjectsViewModel">
      <projectViews:ProjectsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
    <DataTemplate DataType="projects:ProjectDialogViewModel">
      <projectViews:ProjectDialogView />
    </DataTemplate>
    <DataTemplate DataType="dialogs:TextPromptViewModel">
      <dialogViews:TextPromptView />
    </DataTemplate>
    <DataTemplate DataType="tagging:AwayPromptViewModel">
      <taggingViews:AwayPromptView />
    </DataTemplate>
    <DataTemplate DataType="vm:KeyboardShortcutsViewModel">
      <views:KeyboardShortcutsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ClockShot/Themes/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://ClockShot/Styles/Typography.axaml" />
  </Application.Styles>
</Application>
