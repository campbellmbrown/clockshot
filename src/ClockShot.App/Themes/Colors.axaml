<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The app's own colours.
    Everything else comes from the Fluent theme.
    Views use the general keys.
    The timeline and the status bar look up the Timeline and State keys in code, through ThemeBrushes.
    Only a Dark variant exists so far.
    A light theme needs a "Light" dictionary with the same keys.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Colours the keys below build on -->
      <Color x:Key="DividerColor">#2C2C31</Color>
      <Color x:Key="PanelColor">#202024</Color>
      <Color x:Key="TextColor">#E8E8EC</Color>
      <Color x:Key="PausedColor">#F2B33D</Color>

      <!-- General -->
      <SolidColorBrush x:Key="Divider" Color="{StaticResource DividerColor}" />
      <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="PausedBadgeText" Color="#000000" />

      <!-- Timeline -->
      <SolidColorBrush x:Key="TimelineBackground" Color="#161618" />
      <SolidColorBrush x:Key="TimelineRulerBackground" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="TimelineLaneBackground" Color="#1C1C1F" />
      <SolidColorBrush x:Key="TimelineLaneAlternateBackground" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="TimelineGridLine" Color="{StaticResource DividerColor}" />
      <SolidColorBrush x:Key="TimelineTick" Color="#7A7A82" />
      <SolidColorBrush x:Key="TimelineText" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="TimelineSecondaryText" Color="#9A9AA2" />
      <SolidColorBrush x:Key="TimelineNowLine" Color="#FF5A5A" />
      <SolidColorBrush x:Key="TimelineHoverLine" Color="#B0FFFFFF" />
      <SolidColorBrush x:Key="TimelineSelectionFill" Color="#334C9AFF" />
      <SolidColorBrush x:Key="TimelineSelectionBorder" Color="#4C9AFF" />
      <SolidColorBrush x:Key="TimelineSelectedBlock" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TimelinePreviewPaused" Color="{StaticResource PausedColor}" />

      <!-- Tracking states -->
      <SolidColorBrush x:Key="StateActive" Color="#3E8E5E" />
      <SolidColorBrush x:Key="StateAway" Color="#6B5A3A" />
      <SolidColorBrush x:Key="StateLocked" Color="#4A4A55" />
      <SolidColorBrush x:Key="StatePaused" Color="{StaticResource PausedColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
