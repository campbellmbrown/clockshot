<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Views use these shared text classes instead of setting font sizes and colours inline. -->
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <!-- Says why something the user did didn't work. -->
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</Styles>
